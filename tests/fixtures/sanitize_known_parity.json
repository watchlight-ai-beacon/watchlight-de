{
  "_comment": "Shared by tests/test_sanitize.py and ts/test/sanitize.test.mjs: both lanes must give the same text for every case and accept or refuse every limit case the same way. ASCII only; Unicode case folding differs between the lanes by design.",
  "limits": {
    "KNOWN_MAX_VALUES": 50000,
    "KNOWN_VALUE_MAX_LENGTH": 512,
    "KNOWN_MAX_TOTAL_LENGTH": 500000
  },
  "cases": [
    {
      "name": "case variants collapse to one value",
      "text": "Ada met ADA and ada; adam stays.",
      "known": [
        "Ada",
        "ADA",
        "ada",
        "aDa"
      ],
      "mode": "tag",
      "expect": "<KNOWN_1> met <KNOWN_1> and <KNOWN_1>; adam stays."
    },
    {
      "name": "first occurrence kept, same spans",
      "text": "Grace Hopper and GRACE HOPPER",
      "known": [
        "GRACE HOPPER",
        "Grace Hopper"
      ],
      "mode": "mask",
      "expect": "[KNOWN] and [KNOWN]"
    },
    {
      "name": "overlapping values merge",
      "text": "Ann Lee Smith and ANN LEE",
      "known": [
        "ann lee",
        "Ann Lee",
        "Lee Smith",
        "LEE SMITH"
      ],
      "mode": "tag",
      "expect": "<KNOWN_1> and <KNOWN_2>"
    },
    {
      "name": "whole word only",
      "text": "Smithfield Road, Smith's file, SMITH.",
      "known": [
        "Smith",
        "smith"
      ],
      "mode": "mask",
      "expect": "Smithfield Road, [KNOWN]'s file, [KNOWN]."
    },
    {
      "name": "blank entries ignored",
      "text": "nothing here",
      "known": [
        "",
        "   "
      ],
      "mode": "tag",
      "expect": "nothing here"
    },
    {
      "name": "metacharacters are literal",
      "text": "see (a.b)*c$ and (A.B)*C$",
      "known": [
        "(a.b)*c$",
        "(A.B)*C$"
      ],
      "mode": "mask",
      "expect": "see [KNOWN] and [KNOWN]"
    },
    {
      "name": "longest entry wins whatever the case",
      "text": "John Smith and JOHN SMITH; john.",
      "known": [
        "JOHN",
        "john smith"
      ],
      "mode": "mask",
      "expect": "[KNOWN] and [KNOWN]; [KNOWN]."
    }
  ],
  "_generated_comment": "generated_cases build their dictionaries, texts and expected texts instead of spelling them out. An entry group gives entries k = 0..count-1, each value*repeat, then grow*k, then k zero-padded to index_width digits (when index_width is given). text and expect are lists of parts, each value*repeat, joined.",
  "generated_cases": [
    {
      "name": "an entry at the length limit matches",
      "known": [
        {
          "value": "q",
          "repeat": 512,
          "count": 1
        }
      ],
      "text": [
        {
          "value": "see ",
          "repeat": 1
        },
        {
          "value": "Q",
          "repeat": 512
        },
        {
          "value": ", not ",
          "repeat": 1
        },
        {
          "value": "q",
          "repeat": 513
        },
        {
          "value": ".",
          "repeat": 1
        }
      ],
      "mode": "mask",
      "expect": [
        {
          "value": "see [KNOWN], not ",
          "repeat": 1
        },
        {
          "value": "q",
          "repeat": 513
        },
        {
          "value": ".",
          "repeat": 1
        }
      ]
    },
    {
      "name": "a 512-deep chain of nested prefixes",
      "known": [
        {
          "value": "a",
          "repeat": 1,
          "count": 512,
          "grow": "a"
        }
      ],
      "text": [
        {
          "value": "x ",
          "repeat": 1
        },
        {
          "value": "A",
          "repeat": 512
        },
        {
          "value": " ",
          "repeat": 1
        },
        {
          "value": "a",
          "repeat": 513
        },
        {
          "value": " ",
          "repeat": 1
        },
        {
          "value": "a",
          "repeat": 7
        },
        {
          "value": " y",
          "repeat": 1
        }
      ],
      "mode": "mask",
      "expect": [
        {
          "value": "x [KNOWN] ",
          "repeat": 1
        },
        {
          "value": "a",
          "repeat": 513
        },
        {
          "value": " [KNOWN] y",
          "repeat": 1
        }
      ]
    },
    {
      "name": "a chain of nested word prefixes",
      "known": [
        {
          "value": "a",
          "repeat": 1,
          "count": 256,
          "grow": " a"
        }
      ],
      "text": [
        {
          "value": "x ",
          "repeat": 1
        },
        {
          "value": "a ",
          "repeat": 300
        },
        {
          "value": "y",
          "repeat": 1
        }
      ],
      "mode": "mask",
      "expect": [
        {
          "value": "x [KNOWN] y",
          "repeat": 1
        }
      ]
    },
    {
      "name": "50,000 distinct entries, 500,000 characters in all",
      "known": [
        {
          "value": "v",
          "repeat": 1,
          "count": 50000,
          "index_width": 9
        }
      ],
      "text": [
        {
          "value": "v000000000, V000049999 and v000050000.",
          "repeat": 1
        }
      ],
      "mode": "tag",
      "expect": [
        {
          "value": "<KNOWN_1>, <KNOWN_2> and v000050000.",
          "repeat": 1
        }
      ]
    },
    {
      "name": "1,000 distinct 500-character entries, 500,000 characters in all",
      "known": [
        {
          "value": "w",
          "repeat": 491,
          "count": 1000,
          "index_width": 9
        }
      ],
      "text": [
        {
          "value": "w",
          "repeat": 491
        },
        {
          "value": "000000999 ",
          "repeat": 1
        },
        {
          "value": "W",
          "repeat": 491
        },
        {
          "value": "000001000",
          "repeat": 1
        }
      ],
      "mode": "mask",
      "expect": [
        {
          "value": "[KNOWN] ",
          "repeat": 1
        },
        {
          "value": "W",
          "repeat": 491
        },
        {
          "value": "000001000",
          "repeat": 1
        }
      ]
    }
  ],
  "limit_cases": [
    {
      "name": "at the entry limit",
      "entries": [
        {
          "value": "a",
          "count": 50000,
          "repeat": 1
        }
      ],
      "error": null
    },
    {
      "name": "one entry over the entry limit",
      "entries": [
        {
          "value": "a",
          "count": 50001,
          "repeat": 1
        }
      ],
      "error": "known holds more than 50000 entries"
    },
    {
      "name": "an entry at the length limit",
      "entries": [
        {
          "value": "q",
          "repeat": 512,
          "count": 1
        }
      ],
      "error": null
    },
    {
      "name": "an entry one over the length limit",
      "entries": [
        {
          "value": "q",
          "repeat": 513,
          "count": 1
        }
      ],
      "error": "known has an entry longer than 512 characters"
    },
    {
      "name": "at the total-length limit",
      "entries": [
        {
          "value": "w",
          "repeat": 500,
          "count": 1000
        }
      ],
      "error": null
    },
    {
      "name": "one character over the total-length limit",
      "entries": [
        {
          "value": "w",
          "repeat": 500,
          "count": 1000
        },
        {
          "value": "w",
          "repeat": 1,
          "count": 1
        }
      ],
      "error": "known holds more than 500000 characters in all"
    }
  ]
}
