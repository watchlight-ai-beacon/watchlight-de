{
  "_comment": "Credential loader cases shared by the Python and TypeScript SDKs. `source: env` loads with Credential.from_env / Credential.fromEnv() from exactly the `env` variables; `source: file` loads with from_file / fromFile from a file holding `file` (null = no such file) with permission bits `mode` (octal string; 0600 when absent) in a directory with permission bits `dir_mode` (octal string; 0700 when absent): a file writable by group or others is refused, one readable by them loads with a warning, and a file in a directory group or others can write is refused unless the directory is sticky. `expect` is the kind and identity claims, or the error class. Every token here is a fixture string, not a credential. Checked by watchlight-core/tests/test_credential_loader_fixture.py. The TypeScript SDK has no credential loader yet (its plugins read WATCHLIGHT_PLUGIN_TOKEN from their configuration and do not remove it from the environment); when it gets one, it must pass these cases too.",
  "cases": [
    {
      "name": "plugin token with tenant",
      "source": "env",
      "env": {
        "WATCHLIGHT_PLUGIN_TOKEN": "wlpa_fixture_not_a_real_token_0001",
        "WATCHLIGHT_TENANT_ID": "t-1"
      },
      "expect": {
        "kind": "plugin",
        "claims": {
          "tenant_id": "t-1",
          "plugin_kind": null,
          "plugin_version": null
        }
      }
    },
    {
      "name": "plugin token with every claim",
      "source": "env",
      "env": {
        "WATCHLIGHT_PLUGIN_TOKEN": "wlpa_fixture_not_a_real_token_0001",
        "WATCHLIGHT_TENANT_ID": "t-1",
        "WATCHLIGHT_PLUGIN_KIND": "openclaw",
        "WATCHLIGHT_PLUGIN_VERSION": "0.3.0"
      },
      "expect": {
        "kind": "plugin",
        "claims": {
          "tenant_id": "t-1",
          "plugin_kind": "openclaw",
          "plugin_version": "0.3.0"
        }
      }
    },
    {
      "name": "plugin token without tenant",
      "source": "env",
      "env": {
        "WATCHLIGHT_PLUGIN_TOKEN": "wlpa_fixture_not_a_real_token_0001"
      },
      "expect": {
        "error": "InvalidCredential"
      }
    },
    {
      "name": "service token with name",
      "source": "env",
      "env": {
        "WATCHLIGHT_SERVICE_TOKEN": "wlsa_fixture_not_a_real_token_0002",
        "WATCHLIGHT_SERVICE_NAME": "wl-proxy",
        "WATCHLIGHT_SERVICE_INSTANCE_ID": "i-1"
      },
      "expect": {
        "kind": "service",
        "claims": {
          "service_name": "wl-proxy",
          "service_instance_id": "i-1"
        }
      }
    },
    {
      "name": "service token without name",
      "source": "env",
      "env": {
        "WATCHLIGHT_SERVICE_TOKEN": "wlsa_fixture_not_a_real_token_0002"
      },
      "expect": {
        "error": "InvalidCredential"
      }
    },
    {
      "name": "plugin variable wins over service variable",
      "source": "env",
      "env": {
        "WATCHLIGHT_PLUGIN_TOKEN": "wlpa_fixture_not_a_real_token_0001",
        "WATCHLIGHT_SERVICE_TOKEN": "wlsa_fixture_not_a_real_token_0002",
        "WATCHLIGHT_TENANT_ID": "t-1",
        "WATCHLIGHT_SERVICE_NAME": "x"
      },
      "expect": {
        "kind": "plugin",
        "claims": {
          "tenant_id": "t-1",
          "plugin_kind": null,
          "plugin_version": null
        }
      }
    },
    {
      "name": "deprecated alias APDP_TOKEN",
      "source": "env",
      "env": {
        "WATCHLIGHT_APDP_TOKEN": "wlpa_fixture_not_a_real_token_0001",
        "WATCHLIGHT_TENANT_ID": "t-1"
      },
      "expect": {
        "kind": "plugin",
        "claims": {
          "tenant_id": "t-1",
          "plugin_kind": null,
          "plugin_version": null
        }
      }
    },
    {
      "name": "deprecated alias WL_APDP_BEARER",
      "source": "env",
      "env": {
        "WL_APDP_BEARER": "wlpa_fixture_not_a_real_token_0001",
        "WATCHLIGHT_TENANT_ID": "t-1"
      },
      "expect": {
        "kind": "plugin",
        "claims": {
          "tenant_id": "t-1",
          "plugin_kind": null,
          "plugin_version": null
        }
      }
    },
    {
      "name": "admin API key prefix is refused",
      "source": "env",
      "env": {
        "WATCHLIGHT_PLUGIN_TOKEN": "wlapdp_ak_fixture_0003",
        "WATCHLIGHT_TENANT_ID": "t-1"
      },
      "expect": {
        "error": "InvalidCredential"
      }
    },
    {
      "name": "unknown prefix is refused",
      "source": "env",
      "env": {
        "WATCHLIGHT_PLUGIN_TOKEN": "sk-fixture-0004",
        "WATCHLIGHT_TENANT_ID": "t-1"
      },
      "expect": {
        "error": "InvalidCredential"
      }
    },
    {
      "name": "nothing set",
      "source": "env",
      "env": {},
      "expect": {
        "error": "CredentialNotFound"
      }
    },
    {
      "name": "empty token is nothing set",
      "source": "env",
      "env": {
        "WATCHLIGHT_PLUGIN_TOKEN": "",
        "WATCHLIGHT_TENANT_ID": "t-1"
      },
      "expect": {
        "error": "CredentialNotFound"
      }
    },
    {
      "name": "plugin file",
      "source": "file",
      "file": "# comment\nAPDP_TOKEN=wlpa_fixture_not_a_real_token_0001\nTENANT_ID=t-1\n\nPLUGIN_KIND=claude\n",
      "expect": {
        "kind": "plugin",
        "claims": {
          "tenant_id": "t-1",
          "plugin_kind": "claude",
          "plugin_version": null
        }
      }
    },
    {
      "name": "service file",
      "source": "file",
      "file": "APDP_TOKEN=wlsa_fixture_not_a_real_token_0002\nSERVICE_NAME=wl-proxy\n",
      "expect": {
        "kind": "service",
        "claims": {
          "service_name": "wl-proxy",
          "service_instance_id": null
        }
      }
    },
    {
      "name": "file without token",
      "source": "file",
      "file": "TENANT_ID=t-1\n",
      "expect": {
        "error": "InvalidCredential"
      }
    },
    {
      "name": "plugin file without tenant",
      "source": "file",
      "file": "APDP_TOKEN=wlpa_fixture_not_a_real_token_0001\n",
      "expect": {
        "error": "InvalidCredential"
      }
    },
    {
      "name": "line without equals",
      "source": "file",
      "file": "APDP_TOKEN=wlpa_fixture_not_a_real_token_0001\nTENANT_ID\n",
      "expect": {
        "error": "InvalidCredential"
      }
    },
    {
      "name": "whitespace around keys and values",
      "source": "file",
      "file": "  APDP_TOKEN = wlpa_fixture_not_a_real_token_0001  \n TENANT_ID = t-2 \n",
      "expect": {
        "kind": "plugin",
        "claims": {
          "tenant_id": "t-2",
          "plugin_kind": null,
          "plugin_version": null
        }
      }
    },
    {
      "name": "admin key in file",
      "source": "file",
      "file": "APDP_TOKEN=wlapdp_ak_fixture_0005\nTENANT_ID=t-1\n",
      "expect": {
        "error": "InvalidCredential"
      }
    },
    {
      "name": "missing file",
      "source": "file",
      "file": null,
      "expect": {
        "error": "CredentialNotFound"
      }
    },
    {
      "name": "a group-readable file loads (with a warning)",
      "source": "file",
      "file": "APDP_TOKEN=wlpa_fixture_not_a_real_token_0001\nTENANT_ID=t-1\n",
      "mode": "0640",
      "expect": {
        "kind": "plugin",
        "claims": {
          "tenant_id": "t-1",
          "plugin_kind": null,
          "plugin_version": null
        }
      }
    },
    {
      "name": "a group-writable file is refused",
      "source": "file",
      "file": "APDP_TOKEN=wlpa_fixture_not_a_real_token_0001\nTENANT_ID=t-1\n",
      "mode": "0620",
      "expect": {
        "error": "InvalidCredential"
      }
    },
    {
      "name": "a world-writable file is refused",
      "source": "file",
      "file": "APDP_TOKEN=wlpa_fixture_not_a_real_token_0001\nTENANT_ID=t-1\n",
      "mode": "0602",
      "expect": {
        "error": "InvalidCredential"
      }
    },
    {
      "name": "a file in a group-writable directory is refused",
      "source": "file",
      "file": "APDP_TOKEN=wlpa_fixture_not_a_real_token_0001\nTENANT_ID=t-1\n",
      "dir_mode": "0770",
      "expect": {
        "error": "InvalidCredential"
      }
    },
    {
      "name": "a file in a world-writable directory is refused",
      "source": "file",
      "file": "APDP_TOKEN=wlpa_fixture_not_a_real_token_0001\nTENANT_ID=t-1\n",
      "dir_mode": "0707",
      "expect": {
        "error": "InvalidCredential"
      }
    },
    {
      "name": "a file in a sticky world-writable directory loads",
      "source": "file",
      "file": "APDP_TOKEN=wlpa_fixture_not_a_real_token_0001\nTENANT_ID=t-1\n",
      "dir_mode": "1777",
      "expect": {
        "kind": "plugin",
        "claims": {
          "tenant_id": "t-1",
          "plugin_kind": null,
          "plugin_version": null
        }
      }
    }
  ]
}
