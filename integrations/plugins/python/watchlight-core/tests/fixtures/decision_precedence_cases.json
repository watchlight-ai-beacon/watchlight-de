        "details": {
          "escalation_required": true,
          "approval_request_id": "apr_1"
        }
      },
      "kind": "terminate"
    },
    {
      "name": "revoke + escalation stays revoke",
      "response": {
        "decision": "Revoke",
        "details": {
          "escalation_required": true,
          "approval_request_id": "apr_1",
          "enforcement": {
