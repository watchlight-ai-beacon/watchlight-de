        "details": {
          "escalation_required": true,
          "approval_request_id": ""
        }
      },
      "kind": "deny"
    },
    {
      "name": "allow + escalation stays allow",
      "response": {
        "decision": "Allow",
        "details": {
          "escalation_required": true,
          "approval_request_id": "apr_1"
        }
      },
      "kind": "allow"
    },
    {
      "name": "terminate",
      "response": {
        "decision": "Terminate"
      },
      "kind": "terminate"
    },
    {
      "name": "terminate + escalation stays terminate",
      "response": {
